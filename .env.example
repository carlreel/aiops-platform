# ===== 复制为 .env 后按需修改 =====
# 服务端口
RAG_PORT=8000
PROM_PORT=9090
GRAFANA_PORT=3000

# 数据库
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_pass
POSTGRES_DB=ragdb

# Ollama（跑在 Windows 宿主机上）
# WSL2 里可用 `ip route show default | awk '{print $3}'` 查到宿主机 IP
OLLAMA_BASE_URL=http://host.docker.internal:11434
# ⚠️ 不要用 qwen3:4b。它的 chat template 在最后一条 user 消息后硬编码 <think> 标签，
#    /api/generate 传 think=false 无效，512 个 num_predict 会被思考过程吃光，
#    response 返回空字符串（但 HTTP 仍是 200，极难发现）。
LLM_MODEL=qwen2.5:3b
EMB_MODEL=bge-m3

# 检索参数
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5

# Grafana 管理员
GF_USER=admin
GF_PASSWORD=admin123
