# 统一换行符，防止 Windows 上 clone 后 shell 脚本变成 CRLF 而无法执行
* text=auto eol=lf

# Shell 脚本必须是 LF，否则在 Linux/WSL 里会报 $'\r': command not found
*.sh   text eol=lf
*.bash text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf

# PowerShell 与批处理必须用 CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gguf binary
*.tar  binary
*.gz   binary
